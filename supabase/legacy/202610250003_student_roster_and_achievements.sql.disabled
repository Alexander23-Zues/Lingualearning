create table public.student_records (
  id uuid primary key default gen_random_uuid(),
  educator_id uuid not null references public.profiles(id) on delete cascade,
  class_label_id uuid references public.class_labels(id) on delete set null,
  display_name text not null check (char_length(btrim(display_name)) between 1 and 120),
  grade_level smallint not null check (grade_level between 1 and 6),
  avatar_key text not null default 'tarsier',
  pin_hash text not null,
  active boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (educator_id, display_name, grade_level)
);

create table public.student_access_sessions (
  id uuid primary key default gen_random_uuid(),
  student_record_id uuid not null references public.student_records(id) on delete cascade,
  educator_id uuid not null references public.profiles(id) on delete cascade,
  token_hash text not null unique,
  expires_at timestamptz not null,
  created_at timestamptz not null default now(),
  revoked_at timestamptz
);

create table public.student_quiz_attempts (
  id uuid primary key default gen_random_uuid(),
  student_record_id uuid not null references public.student_records(id) on delete restrict,
  educator_id uuid not null references public.profiles(id) on delete restrict,
  quiz_id uuid not null references public.quizzes(id) on delete restrict,
  quiz_title_snapshot text not null,
  total_items integer not null check (total_items >= 0),
  correct_count integer not null check (correct_count between 0 and total_items),
  submitted_at timestamptz not null default now(),
  submission_id uuid not null unique
);

create table public.student_quiz_answers (
  id uuid primary key default gen_random_uuid(),
  attempt_id uuid not null references public.student_quiz_attempts(id) on delete restrict,
  question_id uuid not null references public.questions(id) on delete restrict,
  selected_option_id uuid references public.question_options(id) on delete restrict,
  answer_text text,
  is_correct boolean,
  created_at timestamptz not null default now(),
  unique (attempt_id, question_id)
);

create table public.student_achievement_events (
  id uuid primary key default gen_random_uuid(),
  student_record_id uuid not null references public.student_records(id) on delete restrict,
  educator_id uuid not null references public.profiles(id) on delete restrict,
  event_type text not null check (event_type in ('quiz_submitted','quiz_perfect','module_completed')),
  title text not null,
  source_attempt_id uuid references public.student_quiz_attempts(id) on delete restrict,
  metadata jsonb not null default '{}',
  earned_at timestamptz not null default now()
);

create index student_records_educator_idx on public.student_records(educator_id, grade_level, active);
create index student_attempts_student_time_idx on public.student_quiz_attempts(student_record_id, submitted_at desc);
create index student_achievements_student_time_idx on public.student_achievement_events(student_record_id, earned_at desc);
create index student_access_expiry_idx on public.student_access_sessions(expires_at) where revoked_at is null;

create or replace function public.create_student_record(
  p_actor_id uuid,
  p_display_name text,
  p_grade_level smallint,
  p_pin text,
  p_class_label_id uuid default null,
  p_avatar_key text default 'tarsier'
)
returns public.student_records
language plpgsql
security definer set search_path = ''
as $$
declare v_record public.student_records;
begin
  if not exists (
    select 1 from public.profiles
    where id = p_actor_id and role = 'educator' and status = 'active'
  ) then raise exception 'Active educator required'; end if;
  if p_pin !~ '^[0-9]{4,8}$' then raise exception 'PIN must contain 4 to 8 digits'; end if;
  if p_class_label_id is not null and not exists (
    select 1 from public.class_labels where id = p_class_label_id and educator_id = p_actor_id
  ) then raise exception 'Class label ownership mismatch'; end if;

  insert into public.student_records(
    educator_id, class_label_id, display_name, grade_level, avatar_key, pin_hash
  ) values (
    p_actor_id, p_class_label_id, btrim(p_display_name), p_grade_level,
    coalesce(nullif(p_avatar_key, ''), 'tarsier'), crypt(p_pin, gen_salt('bf', 10))
  ) returning * into v_record;
  return v_record;
end;
$$;

create or replace function public.unlock_student_journey(
  p_actor_id uuid,
  p_student_record_id uuid,
  p_pin text
)
returns jsonb
language plpgsql
security definer set search_path = ''
as $$
declare
  v_record public.student_records%rowtype;
  v_token text := encode(gen_random_bytes(32), 'hex');
  v_expiry timestamptz := now() + interval '30 minutes';
begin
  select * into v_record from public.student_records
  where id = p_student_record_id and educator_id = p_actor_id and active = true;
  if v_record.id is null then raise exception 'Student record not found'; end if;
  if crypt(p_pin, v_record.pin_hash) <> v_record.pin_hash then raise exception 'Incorrect student PIN'; end if;

  insert into public.student_access_sessions(student_record_id, educator_id, token_hash, expires_at)
  values (v_record.id, p_actor_id, encode(digest(v_token, 'sha256'), 'hex'), v_expiry);
  return jsonb_build_object(
    'token', v_token,
    'expires_at', v_expiry,
    'student', jsonb_build_object(
      'id', v_record.id,
      'display_name', v_record.display_name,
      'grade_level', v_record.grade_level,
      'avatar_key', v_record.avatar_key
    )
  );
end;
$$;

create or replace function public.resolve_student_session(p_token text)
returns public.student_access_sessions
language sql
stable
security definer set search_path = ''
as $$
  select * from public.student_access_sessions
  where token_hash = encode(digest(p_token, 'sha256'), 'hex')
    and revoked_at is null and expires_at > now()
  limit 1
$$;

create or replace function public.student_module_catalog(p_actor_id uuid, p_token text)
returns jsonb
language plpgsql
security definer set search_path = ''
as $$
declare
  v_session public.student_access_sessions%rowtype;
  v_result jsonb;
begin
  select * into v_session from public.resolve_student_session(p_token);
  if v_session.id is null or v_session.educator_id <> p_actor_id then
    raise exception 'Student session is invalid or expired';
  end if;

  select coalesce(jsonb_agg(module order by module ->> 'title'), '[]'::jsonb) into v_result
  from (
    select jsonb_build_object(
      'id', q.id,
      'title', q.title,
      'grade_level', q.grade_level,
      'questions', coalesce((
        select jsonb_agg(jsonb_build_object(
          'id', question.id,
          'prompt', question.prompt,
          'type', question.question_type,
          'options', coalesce((
            select jsonb_agg(jsonb_build_object('id', option.id, 'text', option.option_text) order by option.position)
            from public.question_options option where option.question_id = question.id
          ), '[]'::jsonb)
        ) order by qi.position)
        from public.quiz_items qi
        join public.questions question on question.id = qi.question_id
        where qi.quiz_id = q.id and question.question_type = 'multiple_choice'
      ), '[]'::jsonb)
    ) as module
    from public.quizzes q
    where q.grade_level = (select grade_level from public.student_records where id = v_session.student_record_id)
      and (q.state = 'published' or q.owner_id = v_session.educator_id)
  ) modules;
  return v_result;
end;
$$;

create or replace function public.submit_student_quiz(
  p_actor_id uuid,
  p_token text,
  p_submission_id uuid,
  p_quiz_id uuid,
  p_answers jsonb
)
returns jsonb
language plpgsql
security definer set search_path = ''
as $$
declare
  v_session public.student_access_sessions%rowtype;
  v_quiz public.quizzes%rowtype;
  v_attempt_id uuid;
  v_total integer;
  v_correct integer;
  v_existing public.student_quiz_attempts%rowtype;
begin
  select * into v_session from public.resolve_student_session(p_token);
  if v_session.id is null or v_session.educator_id <> p_actor_id then
    raise exception 'Student session is invalid or expired';
  end if;
  select * into v_existing from public.student_quiz_attempts where submission_id = p_submission_id;
  if v_existing.id is not null then
    return jsonb_build_object(
      'attempt_id', v_existing.id,
      'correct', v_existing.correct_count,
      'total', v_existing.total_items
    );
  end if;
  select * into v_quiz from public.quizzes where id = p_quiz_id;
  if v_quiz.id is null or not (v_quiz.state = 'published' or v_quiz.owner_id = v_session.educator_id) then
    raise exception 'Quiz is unavailable';
  end if;

  select count(*) into v_total
  from public.quiz_items qi join public.questions q on q.id = qi.question_id
  where qi.quiz_id = p_quiz_id and q.question_type = 'multiple_choice';

  select count(*) into v_correct
  from jsonb_to_recordset(p_answers) as answer(question_id uuid, selected_option_id uuid)
  join public.quiz_items qi on qi.quiz_id = p_quiz_id and qi.question_id = answer.question_id
  join public.question_options qo on qo.id = answer.selected_option_id
    and qo.question_id = answer.question_id and qo.is_correct = true;

  insert into public.student_quiz_attempts(
    student_record_id, educator_id, quiz_id, quiz_title_snapshot,
    total_items, correct_count, submission_id
  ) values (
    v_session.student_record_id, v_session.educator_id, p_quiz_id, v_quiz.title,
    v_total, v_correct, p_submission_id
  ) returning id into v_attempt_id;

  insert into public.student_quiz_answers(attempt_id, question_id, selected_option_id, is_correct)
  select v_attempt_id, answer.question_id, answer.selected_option_id, coalesce(qo.is_correct, false)
  from jsonb_to_recordset(p_answers) as answer(question_id uuid, selected_option_id uuid)
  join public.quiz_items qi on qi.quiz_id = p_quiz_id and qi.question_id = answer.question_id
  left join public.question_options qo on qo.id = answer.selected_option_id and qo.question_id = answer.question_id
  on conflict (attempt_id, question_id) do nothing;

  insert into public.student_achievement_events(
    student_record_id, educator_id, event_type, title, source_attempt_id, metadata
  ) values (
    v_session.student_record_id, v_session.educator_id, 'quiz_submitted',
    'Completed ' || v_quiz.title, v_attempt_id,
    jsonb_build_object('correct', v_correct, 'total', v_total)
  );
  if v_total > 0 and v_correct = v_total then
    insert into public.student_achievement_events(
      student_record_id, educator_id, event_type, title, source_attempt_id, metadata
    ) values (
      v_session.student_record_id, v_session.educator_id, 'quiz_perfect',
      'Perfect score: ' || v_quiz.title, v_attempt_id,
      jsonb_build_object('correct', v_correct, 'total', v_total)
    );
  end if;
  return jsonb_build_object('attempt_id', v_attempt_id, 'correct', v_correct, 'total', v_total);
end;
$$;

create or replace function public.student_journey_history(p_actor_id uuid, p_token text)
returns jsonb
language plpgsql
security definer set search_path = ''
as $$
declare
  v_session public.student_access_sessions%rowtype;
  v_result jsonb;
begin
  select * into v_session from public.resolve_student_session(p_token);
  if v_session.id is null or v_session.educator_id <> p_actor_id then
    raise exception 'Student session is invalid or expired';
  end if;
  select jsonb_build_object(
    'attempts', coalesce((select jsonb_agg(jsonb_build_object(
      'id', a.id, 'title', a.quiz_title_snapshot, 'correct', a.correct_count,
      'total', a.total_items, 'submitted_at', a.submitted_at
    ) order by a.submitted_at desc) from public.student_quiz_attempts a
      where a.student_record_id = v_session.student_record_id), '[]'::jsonb),
    'achievements', coalesce((select jsonb_agg(jsonb_build_object(
      'id', e.id, 'type', e.event_type, 'title', e.title,
      'metadata', e.metadata, 'earned_at', e.earned_at
    ) order by e.earned_at desc) from public.student_achievement_events e
      where e.student_record_id = v_session.student_record_id), '[]'::jsonb)
  ) into v_result;
  return v_result;
end;
$$;

alter table public.student_records enable row level security;
alter table public.student_access_sessions enable row level security;
alter table public.student_quiz_attempts enable row level security;
alter table public.student_quiz_answers enable row level security;
alter table public.student_achievement_events enable row level security;

revoke all on public.student_records, public.student_access_sessions,
  public.student_quiz_attempts, public.student_quiz_answers,
  public.student_achievement_events from anon, authenticated;
grant select on public.student_records, public.student_quiz_attempts,
  public.student_quiz_answers, public.student_achievement_events to authenticated;

create policy student_records_owner_or_admin on public.student_records for select to authenticated
using (
  (educator_id = (select auth.uid()) and (select public.is_active_educator()))
  or (select public.is_active_administrator())
);
create policy student_attempts_owner_or_admin on public.student_quiz_attempts for select to authenticated
using (
  (educator_id = (select auth.uid()) and (select public.is_active_educator()))
  or (select public.is_active_administrator())
);
create policy student_answers_owner_or_admin on public.student_quiz_answers for select to authenticated
using (exists (
  select 1 from public.student_quiz_attempts a where a.id = attempt_id
    and ((a.educator_id = (select auth.uid()) and (select public.is_active_educator()))
      or (select public.is_active_administrator()))
));
create policy student_achievements_owner_or_admin on public.student_achievement_events for select to authenticated
using (
  (educator_id = (select auth.uid()) and (select public.is_active_educator()))
  or (select public.is_active_administrator())
);

revoke all on function public.create_student_record(uuid,text,smallint,text,uuid,text) from public, anon, authenticated;
revoke all on function public.unlock_student_journey(uuid,uuid,text) from public, anon, authenticated;
revoke all on function public.resolve_student_session(text) from public, anon, authenticated;
revoke all on function public.student_module_catalog(uuid,text) from public, anon, authenticated;
revoke all on function public.submit_student_quiz(uuid,text,uuid,uuid,jsonb) from public, anon, authenticated;
revoke all on function public.student_journey_history(uuid,text) from public, anon, authenticated;
grant execute on function public.create_student_record(uuid,text,smallint,text,uuid,text) to service_role;
grant execute on function public.unlock_student_journey(uuid,uuid,text) to service_role;
grant execute on function public.resolve_student_session(text) to service_role;
grant execute on function public.student_module_catalog(uuid,text) to service_role;
grant execute on function public.submit_student_quiz(uuid,text,uuid,uuid,jsonb) to service_role;
grant execute on function public.student_journey_history(uuid,text) to service_role;

create or replace function public.block_achievement_mutation()
returns trigger
language plpgsql
set search_path = ''
as $$
begin
  raise exception 'Student submissions and achievements are append-only';
end;
$$;

create trigger block_student_attempt_changes before update or delete on public.student_quiz_attempts
for each row execute function public.block_achievement_mutation();
create trigger block_student_answer_changes before update or delete on public.student_quiz_answers
for each row execute function public.block_achievement_mutation();
create trigger block_student_achievement_changes before update or delete on public.student_achievement_events
for each row execute function public.block_achievement_mutation();
